---
import { diagrams, timing, type DiagramVariant, type DiagramStep } from './migrationSequence';
import DatabaseIcon from './DatabaseIcon.astro';
import DocumentIcon from './DocumentIcon.astro';

interface Props {
  variant: DiagramVariant;
  class?: string;
  id?: string;
  animate?: boolean;
  showTitle?: boolean;
}

const { variant, class: className, id = `migration-sequence-${variant}`, animate = true, showTitle = true } = Astro.props;
const config = diagrams[variant];
const titleId = `${id}-title`;
const descriptionId = `${id}-description`;
const groupStart = (group: number) => 120 + group * timing.groupPause;
const delayFor = (step: DiagramStep, index: number) => groupStart(step.group) + config.steps.slice(0, index).filter((item) => item.group === step.group).length * timing.stepGap;
const finalGroup = Math.max(...config.steps.map((step) => step.group));
const lastStepDelay = Math.max(...config.steps.map((step, index) => delayFor(step, index)));
const statusDelay = lastStepDelay + 380 + timing.statusGap;
const statusBefore = config.steps.filter((step) => step.group === finalGroup - 1).at(-1)!;
const statusAfter = config.steps.find((step) => step.group === finalGroup)!;
const highlightFor = (group: number) => config.highlight.find((highlight) => highlight.groups.includes(group));
const beforeHighlight = highlightFor(statusBefore.group);
const afterHighlight = highlightFor(statusAfter.group);
const beforeEdge = beforeHighlight ? beforeHighlight.y + beforeHighlight.height : statusBefore.y + (statusBefore.kind === 'seeding' ? 58 : 60);
const afterEdge = afterHighlight ? afterHighlight.y : statusAfter.y;
const statusY = (beforeEdge + afterEdge) / 2;
const labelWidth = (label: string) => label.length * 9 + 38;
const [titleBrand, ...titleCommand] = config.title.split(' ');
const titleBrandColor = titleBrand === 'supabee' ? 'var(--warning)' : 'var(--diagram-brand)';
const highlightX = 270;
const highlightWidth = 420;
const migrationX = 310;
const migrationWidth = 340;
const seedX = 310;
const seedWidth = 340;
const seedStyle = (failed = false) => failed
  ? { fill: 'color-mix(in oklab, var(--danger) 12%, var(--card))', stroke: 'var(--danger)', icon: 'var(--danger)', text: 'var(--danger)' }
  : { fill: 'color-mix(in oklab, var(--success) 12%, var(--card))', stroke: 'var(--success)', icon: 'var(--success)', text: 'var(--success)' };
---

<figure class:list={['migration-diagram mx-auto w-full max-w-sm', className]}>
  {config.loopTitle
    ? (
      <figcaption data-node="loop-title" data-initial-text={config.loopTitle.initial} class="text-heading mb-6 text-center text-foreground">
        <span class="relative inline-block">
          <span data-loop-brand style="color: var(--diagram-brand)">supabase</span><span data-loop-command> db reset</span>
          <span data-loop-strike aria-hidden="true" class="absolute inset-x-0 top-1/2 origin-left bg-current" style="height: 2px; transform: scaleX(0);"></span>
        </span>
      </figcaption>
    )
    : showTitle && (
      <figcaption class="text-heading mb-6 text-center text-foreground">
        <span style={`color: ${titleBrandColor}`}>{titleBrand}</span> {titleCommand.join(' ')}
      </figcaption>
    )}
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="440"
    height={config.height}
    viewBox={`260 0 440 ${config.height}`}
    role="img"
    aria-labelledby={`${titleId} ${descriptionId}`}
    class="h-auto w-full"
    data-migration-sequence={animate ? '' : undefined}
    data-phases={config.phases ? JSON.stringify(config.phases) : undefined}
    data-initial-status={config.status}
  >
    <title id={titleId}>{config.title}</title>
    <desc id={descriptionId}>{config.description}</desc>

    {config.highlight.map((group, index) => {
      const width = labelWidth(group.label);
      const delay = groupStart(group.groups[0]);
      const isLiveDatabase = group.label === 'Live database';
      const highlightColor = isLiveDatabase ? 'var(--success)' : 'var(--accent)';
      const highlightTextColor = isLiveDatabase ? 'var(--card)' : 'var(--accent-foreground)';
      const highlightFillOpacity = isLiveDatabase ? 0.05 : 0.2;
      return (
        <g data-node={`highlight-${index}`} data-sequence-node data-kind="item" data-delay={delay}>
          <rect x={highlightX} y={group.y} width={highlightWidth} height={group.height} rx="22" fill={highlightColor} fill-opacity={highlightFillOpacity} stroke={highlightColor} stroke-width="0.25" />
          <rect x={highlightX + 26} y={group.y - 13} width={width} height="30" rx="15" fill={highlightColor} />
          <text x={highlightX + 26 + width / 2} y={group.y + 7} text-anchor="middle" font-size="14" font-weight="500" fill={highlightTextColor}>{group.label}</text>
        </g>
      );
    })}

    <g fill="none" stroke="var(--border)" stroke-width="1">
      {config.steps.slice(0, -1).map((step, index) => {
        const nextStep = config.steps[index + 1];
        const delay = delayFor(nextStep, index + 1) - 130;
        return (
          <path
            data-node={`connector-${index}`}
            data-sequence-node
            data-kind="connector"
            data-delay={delay}
            pathLength="1"
            d={`M480 ${step.y + (step.kind === 'seeding' ? 58 : 60)}V${nextStep.y}`}
          />
        );
      })}
      {config.extraConnectors?.map((connector) => (
        <path data-node={connector.id} data-extra-node data-kind="connector" pathLength="1" d={connector.path} opacity="0" />
      ))}
    </g>

    <g font-family="Inter, ui-sans-serif, system-ui, sans-serif">
      {config.steps.map((step, index) => {
        const delay = delayFor(step, index);
        if (step.kind === 'seeding') {
          const colors = seedStyle(step.failed);
          return (
            <g data-node={`step-${index}`} data-sequence-node data-kind="item" data-delay={delay} class="diagram-seed">
              <rect data-seed-role="surface" x={seedX} y={step.y} width={seedWidth} height="58" rx="29" fill={colors.fill} stroke={colors.stroke} stroke-width="0.25" />
              <DatabaseIcon x={seedX + 13} y={step.y + 18} color={colors.icon} />
              <text data-seed-role="text" x={seedX + 56} y={step.y + 37} font-size="21" font-weight="400" fill={colors.text}>{step.label}</text>
            </g>
          );
        }
        const isNew = step.kind === 'new-migration';
        return (
          <g data-node={`step-${index}`} data-sequence-node data-kind="item" data-delay={delay} class:list={{ 'diagram-new': isNew }}>
            <rect x={migrationX} y={step.y} width={migrationWidth} height="60" rx="12" fill={isNew ? 'color-mix(in oklab, var(--warning) 18%, var(--card))' : 'var(--card)'} stroke={isNew ? 'var(--warning)' : 'var(--border)'} stroke-width="0.25" />
            <DocumentIcon x={migrationX + 16} y={step.y + 17} color={isNew ? 'var(--warning)' : 'var(--muted-foreground)'} />
            <text x={migrationX + 56} y={step.y + 38} font-size="21" font-weight={isNew ? 500 : 400} fill="var(--foreground)">{step.label}</text>
          </g>
        );
      })}
    </g>

    <g data-node="status" data-sequence-node data-kind="status" data-delay={statusDelay} font-family="Inter, ui-sans-serif, system-ui, sans-serif">
      <g data-status-kind="conflict" opacity={config.status === 'conflict' ? 1 : 0}>
        <circle cx="480" cy={statusY} r="18" fill="var(--danger)" />
        <text x="480" y={statusY + 7} text-anchor="middle" font-size="20" font-weight="600" fill="var(--card)">!</text>
        <text x="514" y={statusY + 7} font-size="18" font-weight="500" fill="var(--danger)">Conflict</text>
      </g>
      <g data-status-kind="success" opacity={config.status === 'success' ? 1 : 0}>
        <circle cx="480" cy={statusY} r="18" fill="var(--success)" />
        <path d={`M472 ${statusY}l5 5 11-12`} fill="none" stroke="var(--card)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        <text x="514" y={statusY + 7} font-size="18" font-weight="500" fill="var(--success)">Success</text>
      </g>
    </g>
  </svg>
</figure>

<script>
  import { setupMigrationSequences } from './migrationSequenceAnimation';

  setupMigrationSequences();
  document.addEventListener('astro:page-load', setupMigrationSequences);
</script>

<style>
  svg { font-family: Inter, ui-sans-serif, system-ui, sans-serif; }
  .diagram-new > rect { filter: drop-shadow(0 7px 11px color-mix(in oklab, var(--warning) 18%, transparent)); }
</style>
