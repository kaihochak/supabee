---
interface Props {
  x: number;
  y: number;
  scale?: number;
  color?: string;
}

const { x, y, scale = 1, color = 'var(--muted-foreground)' } = Astro.props;
---

<g transform={`translate(${x} ${y}) scale(${scale})`} fill="none" stroke={color} stroke-width="0.5" stroke-linecap="round" stroke-linejoin="round">
  <path d="M0 0h14l8 8v18H0z" />
  <path d="M14 0v8h8M6 15h10M6 21h8" />
</g>
