---
import MigrationSequence from './MigrationSequence.astro';

interface Props {
  class?: string;
  showTitles?: boolean;
}

const { class: className, showTitles = true } = Astro.props;
---

<MigrationSequence
  variant="reset-conflict"
  class={className}
  id="reset-sequence-comparison"
  showTitle={showTitles}
  transition
/>
